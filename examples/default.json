{
  "schemaVersion": 3,
  "name": "OwnTV default",
  "background": { "type": "gradient", "colors": ["#0E0F13", "#16203A"], "angle": 160 },
  "screensaver": { "page": "screensaver", "after": 60, "standby": { "after": 240 } },
  "pages": [
    {
      "id": "home",
      "initialFocus": "favorites",
      "root": {
        "type": "column",
        "id": "root",
        "width": "fill",
        "height": "fill",
        "padding": [48, 28],
        "spacing": 20,
        "scroll": true,
        "children": [
          {
            "type": "row",
            "id": "header",
            "width": "fill",
            "children": [
              {
                "type": "column",
                "id": "time_block",
                "children": [
                  { "type": "clock", "id": "clock", "format": "HH:mm", "textStyle": "display" },
                  { "type": "clock", "id": "date", "format": "EEEE, d MMMM", "textStyle": "body", "color": "@textMuted" }
                ]
              },
              { "type": "spacer", "id": "header_gap", "weight": 1 },
              {
                "type": "shortcut",
                "id": "settings_button",
                "label": "Settings",
                "icon": "settings",
                "action": { "type": "open_launcher_settings" },
                "tile": { "shape": "icon", "size": "small" }
              }
            ]
          },
          {
            "type": "app_row",
            "id": "favorites",
            "title": "Favorites",
            "source": { "type": "list", "list": "favorites" },
            "tile": { "shape": "banner", "size": "large" }
          },
          {
            "type": "app_grid",
            "id": "all_apps",
            "title": "All apps",
            "columns": 5,
            "source": { "type": "all" }
          }
        ]
      }
    },
    {
      "id": "screensaver",
      "title": "Screensaver",
      "background": { "type": "gradient", "colors": ["#05060A", "#101830"], "angle": 160 },
      "root": {
        "type": "column",
        "id": "screensaver_root",
        "arrange": "center",
        "contentAlign": "center",
        "children": [
          { "type": "clock", "id": "screensaver_clock", "format": "HH:mm", "fontSize": 96 },
          { "type": "clock", "id": "screensaver_date", "format": "EEEE, d MMMM", "textStyle": "title", "color": "@textMuted" }
        ]
      }
    }
  ]
}
