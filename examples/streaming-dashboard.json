{
  "schemaVersion": 3,
  "name": "Streaming dashboard",
  "theme": {
    "colors": {
      "background": "#0B0D12",
      "surface": "#1A1F2B",
      "primary": "#E50914",
      "text": "#F2F2F2",
      "textMuted": "#A0A7B4",
      "focus": "#FFFFFF",
      "custom": { "hero": "#2A0E12" }
    },
    "cornerRadius": 10
  },
  "background": { "type": "gradient", "colors": ["#2A0E12", "#0B0D12", "#0B0D12"], "angle": 180 },
  "pageTabs": true,
  "keyBindings": [
    { "key": "red", "action": { "type": "go_to_page", "page": "watch" } },
    { "key": "green", "action": { "type": "go_to_page", "page": "apps" } },
    { "key": "yellow", "action": { "type": "open_input", "input": "hdmi1" } },
    { "key": "menu", "press": "long", "action": { "type": "open_launcher_settings" } }
  ],
  "pages": [
    {
      "id": "watch",
      "title": "Watch",
      "initialFocus": "streaming",
      "root": {
        "type": "column",
        "id": "watch_root",
        "width": "fill",
        "height": "fill",
        "padding": [48, 16],
        "spacing": 18,
        "scroll": true,
        "children": [
          {
            "type": "row",
            "id": "hero",
            "width": "fill",
            "padding": [24, 18],
            "background": "@hero",
            "cornerRadius": 16,
            "children": [
              {
                "type": "column",
                "id": "hero_text",
                "weight": 1,
                "children": [
                  { "type": "text", "id": "hero_title", "text": "Movie night", "textStyle": "headline", "bold": true },
                  { "type": "text", "id": "hero_sub", "text": "Pick a service and press OK.", "textStyle": "body", "color": "@textMuted" }
                ]
              },
              { "type": "clock", "id": "hero_clock", "format": "HH:mm", "textStyle": "headline" }
            ]
          },
          {
            "type": "app_row",
            "id": "streaming",
            "title": "Streaming",
            "source": { "type": "list", "list": "streaming" },
            "tile": { "shape": "card", "size": "large" }
          },
          {
            "type": "app_row",
            "id": "music",
            "title": "Music",
            "source": { "type": "list", "list": "music" },
            "tile": { "shape": "banner", "size": "medium" }
          },
          {
            "type": "row",
            "id": "quick_actions",
            "spacing": 16,
            "children": [
              {
                "type": "shortcut",
                "id": "goto_apps",
                "label": "All apps",
                "icon": "apps",
                "action": { "type": "go_to_page", "page": "apps" },
                "tile": { "shape": "icon", "size": "small" }
              },
              {
                "type": "shortcut",
                "id": "wifi",
                "label": "Network",
                "icon": "🛜",
                "action": { "type": "open_system_settings", "screen": "network" },
                "tile": { "shape": "icon", "size": "small" }
              },
              {
                "type": "shortcut",
                "id": "system_settings",
                "label": "Settings",
                "icon": "settings",
                "action": { "type": "open_system_settings" },
                "tile": { "shape": "icon", "size": "small" }
              },
              {
                "type": "shortcut",
                "id": "launcher_settings",
                "label": "OwnTV",
                "icon": "menu",
                "action": { "type": "open_launcher_settings" },
                "tile": { "shape": "icon", "size": "small" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "apps",
      "title": "Apps",
      "root": {
        "type": "column",
        "id": "apps_root",
        "width": "fill",
        "height": "fill",
        "padding": [48, 16],
        "scroll": true,
        "children": [
          {
            "type": "app_grid",
            "id": "apps_grid",
            "columns": 7,
            "source": { "type": "all", "sort": "recently_installed" },
            "tile": { "shape": "icon", "size": "medium" }
          }
        ]
      }
    }
  ]
}
