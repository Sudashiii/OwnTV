{
  "schemaVersion": 3,
  "name": "Minimal",
  "theme": {
    "colors": { "background": "#000000", "surface": "#141414", "primary": "#FFFFFF", "text": "#F5F5F5", "textMuted": "#8A8A8A", "focus": "#FFFFFF" },
    "focus": { "scale": 1.05, "borderWidth": 2, "glow": false }
  },
  "pages": [
    {
      "id": "home",
      "root": {
        "type": "column",
        "id": "root",
        "width": "fill",
        "height": "fill",
        "padding": [64, 48],
        "contentAlign": "center",
        "arrange": "space_between",
        "children": [
          {
            "type": "row",
            "id": "header",
            "width": "fill",
            "contentAlign": "top",
            "children": [
              { "type": "clock", "id": "clock", "format": "HH:mm", "textStyle": "display", "bold": true },
              { "type": "spacer", "id": "header_gap", "weight": 1 },
              { "type": "shortcut", "id": "settings_button", "label": "Settings", "icon": "settings", "action": { "type": "open_launcher_settings" }, "tile": { "shape": "icon", "size": "small" } }
            ]
          },
          {
            "type": "app_row",
            "id": "apps",
            "source": { "type": "all", "sort": "alphabetical" },
            "tile": { "shape": "icon", "size": "medium" }
          }
        ]
      }
    }
  ]
}
