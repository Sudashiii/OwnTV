{
  "schemaVersion": 3,
  "name": "Apple TV",
  "description": "tvOS 26/27 Liquid Glass: a full-bleed Top Shelf for the focused app, a glass dock, 5:3 icons that lift, sway and catch the light on focus.",
  "theme": {
    "colors": {
      "background": "#000000",
      "surface": "#2C2C2E",
      "primary": "#0A84FF",
      "text": "#F5F5F7",
      "textMuted": "#98989D",
      "focus": "#FFFFFF"
    },
    "cornerRadius": 16,
    "focus": {
      "scale": 1.15,
      "borderWidth": 0,
      "glow": true,
      "glowColor": "#B3000000",
      "glowSize": 22,
      "highlight": true,
      "motion": "sway"
    }
  },
  "background": { "type": "gradient", "colors": ["#1C1C1E", "#000000"], "angle": 180 },
  "defaults": {
    "app_row": { "spacing": 30, "tile": { "shape": "banner", "width": 148, "aspectRatio": 1.6667, "showLabel": "focused", "rim": true } },
    "app_grid": { "spacing": 30, "columns": 5, "tile": { "shape": "banner", "aspectRatio": 1.6667, "showLabel": "focused", "rim": true } },
    "folder": {
      "color": "#33FFFFFF",
      "tile": { "shape": "banner", "aspectRatio": 1.6667, "showLabel": "focused", "rim": true },
      "itemTile": { "shape": "banner", "aspectRatio": 1.6667, "showLabel": "focused", "rim": true },
      "columns": 5
    },
    "shortcut": { "tile": { "shape": "banner", "aspectRatio": 1.6667, "showLabel": "focused", "rim": true } }
  },
  "screensaver": { "page": "screensaver", "after": 300 },
  "pages": [
    {
      "id": "home",
      "initialFocus": "dock",
      "root": {
        "type": "column",
        "id": "root",
        "scroll": true,
        "scrollAlign": "start",
        "scrollMargin": 24,
        "children": [
          {
            "type": "stack",
            "id": "shelf",
            "width": "fill",
            "height": 410,
            "revealOnFocus": true,
            "children": [
              {
                "type": "hero",
                "id": "top_shelf",
                "target": "dock",
                "width": "fill",
                "height": "fill",
                "fade": 0.3,
                "scrim": 0.5,
                "contentAlign": "top_start",
                "slides": [
                  {
                    "title": "Welcome",
                    "description": "Focus an app in the dock to see it here. Give any app a backdrop and description in the layout's apps section.",
                    "background": { "type": "gradient", "colors": ["#3A3A3C", "#1C1C1E"], "angle": 135 }
                  }
                ]
              },
              {
                "type": "shortcut",
                "id": "settings_button",
                "label": "Settings",
                "icon": "settings",
                "align": "top_end",
                "padding": [0, 24, 50, 0],
                "action": { "type": "open_launcher_settings" },
                "tile": { "shape": "icon", "size": "small" }
              },
              {
                "type": "column",
                "id": "dock_area",
                "width": "fill",
                "align": "bottom",
                "padding": [20, 0, 20, 14],
                "children": [
                  {
                    "type": "app_row",
                    "id": "dock",
                    "source": { "type": "all" },
                    "limit": 5,
                    "tile": { "showLabel": "never" },
                    "background": { "type": "glass", "tint": "#1AFFFFFF" },
                    "cornerRadius": 34,
                    "padding": [30, 14]
                  }
                ]
              }
            ]
          },
          {
            "type": "app_grid",
            "id": "grid",
            "source": { "type": "all" },
            "skip": 5,
            "padding": [50, 12, 50, 48]
          }
        ]
      }
    },
    {
      "id": "screensaver",
      "title": "Screensaver",
      "background": {
        "type": "slideshow",
        "images": [
          { "src": "https://images.unsplash.com/photo-1565479715608-5338dec5ff7a?w=1920&q=80&fm=jpg" },
          { "src": "https://images.unsplash.com/photo-1519681393784-d120267933ba?w=1920&q=80&fm=jpg" },
          { "src": "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=1920&q=80&fm=jpg" },
          { "src": "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=1920&q=80&fm=jpg" },
          { "src": "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80&fm=jpg" }
        ],
        "interval": 45,
        "transition": 2500,
        "dim": 0.15
      },
      "root": {
        "type": "column",
        "id": "screensaver_root",
        "padding": [56, 44],
        "arrange": "end",
        "children": [
          { "type": "clock", "id": "screensaver_clock", "format": "H:mm", "fontSize": 64 },
          { "type": "clock", "id": "screensaver_date", "format": "EEEE, d MMMM", "textStyle": "title", "color": "@textMuted" }
        ]
      }
    }
  ]
}
